[Unit]
StartLimitIntervalSec=0
Description=Private Transmission daemon for Atlas Bridge
After=atlas-bridge.network
Requires=atlas-bridge.network

[Container]
Pull=never
UserNS=keep-id:uid=65532,gid=65532
# install.sh keeps the live Image= line (production pins a digest).
Image=docker.io/linuxserver/transmission:4.0.6
ContainerName=atlas-transmission
Network=atlas-bridge.network
Environment=PUID=65532
Environment=PGID=65532
Environment=TZ=Africa/Johannesburg
Environment=TRANSMISSION_WEB_HOME=/combustion-release/
Environment=TRANSMISSION_RPC_AUTHENTICATION_REQUIRED=false
Volume=@LIBRARY_ROOT@/atlas-bridge/transmission:/config:Z
Volume=@LIBRARY_ROOT@/atlas-bridge/data/torrents:/downloads:Z
HealthCmd=/usr/bin/transmission-remote 127.0.0.1:9091 -l
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
RestartSec=15s
MemoryMax=384M
CPUQuota=150%
TasksMax=256
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
