[Unit]
Description=Bounded Atlas updater on M900
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I @LIBRARY_UPDATER@ update
ExecStopPost=/usr/bin/python3 -I @LIBRARY_UPDATER@ recover
TimeoutStartSec=15min
TimeoutStopSec=5min
KillMode=control-group
