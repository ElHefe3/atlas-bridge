# Production library layout on M900 (lab-pta-03). install.sh reads this file.
# Kavita, Atlas Bridge and Transmission run rootless as this locked account.
LIBRARY_ACCOUNT=lab-library
LIBRARY_HOST=lab-pta-03
# The account home holds the Podman store, Quadlets and user units.
LIBRARY_HOME=/mnt/secondary/lab-services/library
# Data root; `current` is a symlink to the active generation directory.
# Library backup and maintenance tools depend on these paths below it:
#   atlas-bridge/deploy/update.lock, atlas-bridge/deploy/lab-update-recovery.json,
#   atlas-bridge/{data,transmission}, kavita/{config,media}, .config/atlas-bridge/secrets
LIBRARY_ROOT=/mnt/secondary/lab-services/library/current
# Root-owned so the service account cannot rewrite its own updater.
LIBRARY_UPDATER=/usr/local/libexec/lab-library-atlas-updater.py
# Kavita's loopback port, used only for post-change health checks.
LIBRARY_KAVITA_PORT=5000
