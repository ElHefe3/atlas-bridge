[Unit]
StartLimitIntervalSec=0
Description=Atlas Bridge
After=network-online.target transmission.service
Wants=network-online.target transmission.service

[Container]
# install.sh keeps the live Image= line. The updater retags pulled images into
# this local pin, so Quadlet never pulls on its own.
Image=localhost/atlas-bridge:current
ContainerName=atlas-bridge
Pull=never
Network=atlas-bridge.network
UserNS=keep-id:uid=65532,gid=65532
Volume=@LIBRARY_ROOT@/atlas-bridge/data:/data:Z
Volume=@LIBRARY_ROOT@/.config/atlas-bridge/secrets:/run/secrets:ro,Z
Environment=ATLAS_BRIDGE_PUBLIC_BASE_URL=http://atlas-bridge:8080
Environment=ATLAS_TRANSMISSION_RPC=http://atlas-transmission:9091/transmission/rpc
Environment=ATLAS_BRIDGE_TORRENT_ATTEMPT_TIMEOUT=10m
Environment=ATLAS_BRIDGE_DOWNLOAD_REQUEST_TIMEOUT=2m
Environment=ATLAS_ANNA_EXTRA_ORIGINS=https://download.booksdl.org,https://wtgadtq.org
# LibGen rotates its download CDN hosts. Verify a change with the live test:
#   go test -tags live -run TestLiveLibGenDownloads -count=1 -v ./internal/providers/
Environment=ATLAS_LIBGEN_EXTRA_ORIGINS=https://library.lol,https://download.booksdl.org,https://cdn1.booksdl.lc,https://cdn2.booksdl.lc,https://cdn3.booksdl.lc,https://cdn4.booksdl.lc,https://cdn5.booksdl.lc
# Bounded metadata-first catalogue sync. These are metadata payloads only;
# content torrents remain selected per acquisition.
Environment=ATLAS_BRIDGE_CATALOGUE_TORRENT=https://annas-archive.pk/dyn/small_file/torrents/managed_by_aa/annas_archive_meta__aacid/annas_archive_meta__aacid__zlib3_records__20240809T171652Z--20260706T193143Z.jsonl.seekable.zst.torrent
Environment=ATLAS_BRIDGE_CATALOGUE_TORRENT_PATH=annas_archive_meta__aacid__zlib3_records__20240809T171652Z--20260706T193143Z.jsonl.seekable.zst
Environment=ATLAS_BRIDGE_CATALOGUE_ZSTD=/data/zlib3-records.jsonl.zst
Environment=ATLAS_BRIDGE_CATALOGUE_FILES_TORRENT=https://annas-archive.pk/dyn/small_file/torrents/managed_by_aa/annas_archive_meta__aacid/annas_archive_meta__aacid__zlib3_files__20230808T051503Z--20260706T185134Z.jsonl.seekable.zst.torrent
Environment=ATLAS_BRIDGE_CATALOGUE_FILES_TORRENT_PATH=annas_archive_meta__aacid__zlib3_files__20230808T051503Z--20260706T185134Z.jsonl.seekable.zst
Environment=ATLAS_BRIDGE_CATALOGUE_FILES_ZSTD=/data/zlib3-files.jsonl.zst
Environment=ATLAS_BRIDGE_CATALOGUE_PAYLOAD_LIMIT=32212254720
Environment=ATLAS_BRIDGE_CATALOGUE_MAX_EXPANDED=128849018880
# Ingestion runs only while /data/catalogue-ingest.pause is absent; see the
# atlas-bridge-ingest-* units. Content torrents are never indexed.
HealthCmd=/usr/local/bin/atlas-bridge healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
RestartSec=15s
MemoryMax=1536M
CPUQuota=150%
TasksMax=256
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
